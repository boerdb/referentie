# Kopieer naar .env.local:
#   copy .env.example .env.local
#
# Next.js (LAN/PWA): npm run dev → http://<jouw-ip>:3020
# MariaDB: server DB (192.168.1.14) — database referentie

DATABASE_URL=mysql://referentie:JOUW_DB_WACHTWOORD@192.168.1.14:3306/referentie

# Redis — sessies, DOI-cache, rate limits
REDIS_URL=redis://192.168.1.14:6379

# Minimaal 32 tekens (openssl rand -base64 32)
AUTH_SECRET=JOUW_LANGE_RANDOM_STRING_MIN_32_TEKENS

UPLOAD_DIR=./data/pdfs
REGISTRATION_OPEN=true

# LAN HMR (optioneel, komma-gescheiden)
# ALLOWED_DEV_ORIGINS=192.168.1.120
