{
  "name": "Referentie",
  "short_name": "Referentie",
  "description": "Referentiebeheer voor wetenschappelijke artikelen",
  "id": "/bibliotheek",
  "start_url": "/bibliotheek",
  "scope": "/",
  "display": "standalone",
